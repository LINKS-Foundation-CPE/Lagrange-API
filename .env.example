API_PORT=8500

# ── Identity provider (OIDC) ─────────────────────────────────────────────────
# Base URL; the realm path is appended, so this is the origin plus whatever
# relative path the provider is served under (Keycloak's KC_HTTP_RELATIVE_PATH).
KEYCLOAK_BASE_URL=https://idp.example.org/auth
KEYCLOAK_REALM=cortex

# ── Platform tokens ──────────────────────────────────────────────────────────
# Symmetric (HS256) signing key for the platform tokens this service issues and
# verifies. Any holder can mint an admin token: generate it randomly, keep it to
# this service, and never hand it to another component.
BACKEND_SECRET=<long random string>
#TOKEN_DURATION=24h

# ── Browser access ───────────────────────────────────────────────────────────
# Origin the dashboard is served from — exact match, scheme and port included.
# Unset means "allow any origin", which is acceptable for local development only.
CORS_ORIGIN=https://dashboard.example.org

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=quantum
POSTGRES_USER=quantumapi
POSTGRES_PASSWORD=<password>

# ── TLS (optional) ───────────────────────────────────────────────────────────
# Set both to terminate TLS in this process instead of at a reverse proxy.
# SSL_CERT=../api.crt
# SSL_KEY=../api.key

# ── Backups (optional) ───────────────────────────────────────────────────────
# The volumes-backup sidecar in docker-compose.yaml is behind the `backup`
# profile and does not run unless you ask for it, so a development instance can
# ignore this whole block. To enable off-site backups of the database volume,
# uncomment COMPOSE_PROFILES below (compose reads it from this file) and fill in
# the S3 endpoint and credentials.
#COMPOSE_PROFILES=backup
#AWS_ENDPOINT=backup.example.org:8010
#AWS_ACCESS_KEY_ID=<key>
#AWS_SECRET_ACCESS_KEY=<secret>

# ── Deployment policy flags (defaults preserve historical behaviour) ─────────
# Constrain reservations to pre-allocated slots of the project's organization
# (true, default) or allow free placement on the calendar (false; slot_id
# becomes optional on POST /api/reservations).
#SLOT_CONSTRAINED_RESERVATIONS=true
# During another organization's pre-allocated slot (outside reservations),
# keep the open queue available to everyone (true, default) or restrict
# submissions to the slot organization and its referencing organizations
# (false).
#ALLOW_FOREIGN_ORG_QUEUE_IN_SLOTS=true
# Accept an explicit `billable` amount on the terminal PUT /jobReport/{jobid}
# and charge that instead of execution_end - execution_start (false, default).
# For deployments whose billable quantity is not an execution window — e.g. an
# HPC batch job charged for the QPU licenses it held over its wall time. The
# amount is subtracted from the project budget verbatim, so the unit is the
# operator's to keep consistent; reports without the field still bill the
# execution window.
#ACCEPT_REPORTED_BILLING=false
# Serve a job viewer only (false, default). When true, the management surface is
# NOT mounted — users, projects, organizations, slots, reservations, logs, budget
# events, announcements, notifications, project membership, /api/own and
# /jobAuthorizer all 404 — and nothing is billed: a terminal job report still
# records the job and its timing, but no budget moves and no ledger row is
# written. What remains is what a user needs to find their own jobs (GET
# /api/jobs, already scoped to the caller) plus /auth/token, /jobReport,
# /userRoles and /metrics. For a site that owns authorization and accounting
# elsewhere — a SLURM cluster charging its own licenses, say.
#JOB_PORTAL_ONLY=false
# Shape of the user identity (users.email, reported as `username` by the QC
# Gateway): "email" (default; must be an e-mail address) or "any" (any
# whitespace-free string, e.g. HPC cluster account names). FROZEN at first
# deployment: the value is stored in the DB on first boot; a later boot with a
# conflicting value refuses to start (changing it once users exist would break
# existing identities and billing attribution), and an unset var adopts the
# frozen value.
#USERNAME_FORMAT=email
# Identity-provider (realm) role that seeds Pulse access — sweep submission,
# the pulla_user platform role. When a login registers a user row that did not
# exist yet, the role sets the user's `pulla_user` flag, which is what
# GET /userRoles/:username reports to the QC Gateway (the only path available to
# HPC principals, whose SPANK tokens carry no roles). It is a default, not a
# mirror: afterwards only an admin changes the flag, so a revocation in the
# dashboard is not undone by the user's next login.
#PULSE_ACCESS_OIDC_ROLE=pulla_user
